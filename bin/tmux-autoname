#!/usr/bin/env sh
# tmux-autoname: deterministic <activity>:<workspace>[/<area>] window names.
# See docs/adr/0005-restore-deterministic-naming.md for the naming rule.
set -eu

gopt() {
  # $1 = option name, $2 = default
  v=$(tmux show-option -gqv "$1" 2>/dev/null) || v=""
  if [ -n "$v" ]; then printf '%s' "$v"; else printf '%s' "$2"; fi
}

wopt() {
  # $1 = window id, $2 = option name
  tmux show-option -t "$1" -wqv "$2" 2>/dev/null || printf ''
}

wset() {
  # $1 = window id, $2 = option name, $3 = value
  tmux set-option -t "$1" -w -q "$2" "$3" 2>/dev/null || true
}

wunset() {
  # $1 = window id, $2 = option name
  tmux set-option -t "$1" -wu "$2" 2>/dev/null || true
}

pane_field() {
  # $1 = pane id, $2 = format variable name (no braces)
  tmux display-message -p -t "$1" "#{$2}" 2>/dev/null || printf ''
}

resolve_win() {
  # $1 = target (pane, window, or empty for current)
  if [ -n "$1" ]; then
    tmux display-message -p -t "$1" '#{window_id}' 2>/dev/null || printf ''
  else
    tmux display-message -p '#{window_id}' 2>/dev/null || printf ''
  fi
}

# Activity: pane_current_command basename, lower-cased, with a
# "-coding-agent" suffix stripped and only [a-z0-9._+-] kept; empty
# becomes "shell".
compute_activity() {
  # $1 = pane_current_command
  pcmd=$1
  name=$(basename -- "$pcmd")
  name=$(printf '%s' "$name" | LC_ALL=C tr '[:upper:]' '[:lower:]')

  case "$name" in
    *-coding-agent) name=${name%-coding-agent} ;;
  esac

  name=$(printf '%s' "$name" | LC_ALL=C sed -E 's/[^a-z0-9._+-]//g')
  [ -n "$name" ] || name="shell"
  printf '%s' "$name"
}

# True (0) when a pane_current_command is a launcher (sudo, env, ...) or an
# interpreter (node, python, ...) whose real program is further down argv.
is_wrapper_command() {
  # $1 = pane_current_command
  name=$(basename -- "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]')
  case "$name" in
    sudo | doas | env | nice | ionice | nohup | time | stdbuf | setsid | \
      timeout | taskset | chrt | flock | systemd-run | unbuffer | chronic | \
      node | nodejs | node[0-9]* | bun | deno | \
      python | python[0-9]* | pypy | pypy[0-9]* | ruby | ruby[0-9]* | perl | perl[0-9]*)
      return 0
      ;;
  esac
  return 1
}

# Print the argv of the foreground process group leader of a pane's tty,
# one argument per line. Empty when it can't be read.
foreground_argv() {
  # $1 = pane_pid
  pid=$1
  case "$pid" in '' | *[!0-9]*) return 0 ;; esac
  if [ -r "/proc/$pid/stat" ]; then
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 0
    # Fields after "(comm) ": state ppid pgrp session tty_nr tpgid ...
    # shellcheck disable=SC2086
    set -- ${stat##*) }
    fg=${6:-}
    case "$fg" in '' | *[!0-9]* | 0 | -*) return 0 ;; esac
    tr '\0' '\n' <"/proc/$fg/cmdline" 2>/dev/null || true
  else
    fg=$(ps -o tpgid= -p "$pid" 2>/dev/null | tr -d ' ') || return 0
    case "$fg" in '' | *[!0-9]* | 0) return 0 ;; esac
    ps -o args= -p "$fg" 2>/dev/null | tr ' ' '\n' || true
  fi
}

# Resolve a launcher/interpreter argv (one arg per line on stdin) to the
# program it really runs: `doas emerge -a` -> emerge,
# `node .../bin/codex` -> codex, `python3 -m http.server` -> http.server.
# Prints nothing when argv is empty.
resolve_argv() {
  LC_ALL=C awk '
    function base(p) { sub(/\/+$/, "", p); sub(/.*\//, "", p); return p }
    function lc(s) { return tolower(s) }
    function is_launcher(n) {
      return n ~ /^(sudo|doas|env|nice|ionice|nohup|time|stdbuf|setsid|timeout|taskset|chrt|flock|systemd-run|unbuffer|chronic)$/
    }
    function is_interp(n) {
      return n ~ /^(node|nodejs|node[0-9].*|bun|deno|python|python[0-9].*|pypy|pypy[0-9].*|ruby|ruby[0-9].*|perl|perl[0-9].*)$/
    }
    # Options that consume the following argument, per launcher.
    function takes_value(n, o) {
      if (n == "sudo") return o ~ /^-[uUgCDhprtTR]$/
      if (n == "doas") return o ~ /^-[uC]$/
      if (n == "env") return o ~ /^(-u|--unset|-C|--chdir|-S|--split-string)$/
      if (n == "nice") return o ~ /^(-n|--adjustment)$/
      if (n == "ionice") return o ~ /^(-c|--class|-n|--classdata|-p|--pid|-P|--pgid|-u|--uid)$/
      if (n == "stdbuf") return o ~ /^-[ioe]$/
      if (n == "timeout") return o ~ /^(-s|--signal|-k|--kill-after)$/
      if (n == "time") return o ~ /^(-f|--format|-o|--output)$/
      if (n == "flock") return o ~ /^(-w|--timeout|-E|--conflict-exit-code)$/
      if (n == "systemd-run") return o ~ /^(-u|--unit|-p|--property|-E|--setenv|--description|--slice|-M|--machine|-H|--host|--uid|--gid|--nice|-D|--working-directory|--on-active|--on-boot|--on-startup|--on-unit-active|--on-unit-inactive|--on-calendar|--timer-property|--path-property|--socket-property|--service-type)$/
      if (n == "chrt") return o ~ /^(-T|--sched-runtime|-P|--sched-period|-D|--sched-deadline)$/
      return 0
    }
    # Positional arguments a launcher takes before the command.
    function leading_positionals(n) {
      if (n == "timeout" || n == "taskset" || n == "chrt" || n == "flock") return 1
      return 0
    }
    function script_name(p,    parts, k, s) {
      k = split(p, parts, "/")
      s = parts[k]
      sub(/\.([cm]?[jt]sx?|py[cw]?|rb|pl)$/, "", s)
      # Generic entry points name the package directory, not the program.
      while (k > 1 && lc(s) ~ /^(cli|index|main|__main__|run|entry|start|bin|dist|lib|src|build|out|esm|cjs)$/) {
        k--
        s = parts[k]
      }
      return s
    }
    { argv[n++] = $0 }
    END {
      i = 0
      while (i < n) {
        name = base(argv[i])
        ln = lc(name)
        if (is_launcher(ln)) {
          j = i + 1
          need = leading_positionals(ln)
          while (j < n) {
            a = argv[j]
            if (a == "--") { j++; break }
            if (ln == "env" && a ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { j++; continue }
            if (a ~ /^-./) { j += takes_value(ln, a) ? 2 : 1; continue }
            if (need > 0) { need--; j++; continue }
            break
          }
          if (j >= n) { print name; exit }
          i = j
          continue
        }
        if (is_interp(ln)) {
          j = i + 1
          sub_seen = 0
          while (j < n) {
            a = argv[j]
            if (a == "--") { j++; break }
            if (a ~ /^-/) {
              if (ln ~ /^(node|nodejs|node[0-9].*|bun|deno)$/) {
                if (a ~ /^(-e|--eval|-p|--print)$/) { print name; exit }
                if (a ~ /^(-r|--require|--import|--loader|--experimental-loader|-C|--conditions)$/) { j += 2; continue }
              } else if (ln ~ /^(python|pypy)/) {
                if (a == "-c") { print name; exit }
                if (a == "-m") {
                  if (j + 1 < n) { m = argv[j + 1]; sub(/\.__main__$/, "", m); print m } else print name
                  exit
                }
                if (a ~ /^-[WX]$/) { j += 2; continue }
              } else if (ln ~ /^ruby/) {
                if (a == "-e") { print name; exit }
                if (a ~ /^-[rIC]$/) { j += 2; continue }
              } else if (ln ~ /^perl/) {
                if (a ~ /^-[eE]$/) { print name; exit }
                if (a ~ /^-[IM]$/) { j += 2; continue }
              }
              j++
              continue
            }
            # bun run x / deno run x: skip the subcommand word once.
            if (!sub_seen && ln ~ /^(bun|deno)$/ && a ~ /^(run|x|task)$/) { sub_seen = 1; j++; continue }
            break
          }
          if (j >= n) { print name; exit }
          s = script_name(argv[j])
          if (s == "") s = name
          print s
          exit
        }
        print name
        exit
      }
    }
  '
}

# Parse a remote host out of an ssh/mosh pane_title, lower-cased.
remote_host_from_title() {
  # $1 = pane_title
  printf '%s' "$1" | LC_ALL=C sed -nE \
    's/^[[:space:]]*(([^@[:space:]]+@)?([a-zA-Z0-9][a-zA-Z0-9.-]{0,252})([:[:space:]].*|$)).*/\3/p' |
    sed -n '1p' |
    LC_ALL=C tr '[:upper:]' '[:lower:]'
}

# True (0) when $1 is $2 or a strict descendant of it.
is_under() {
  # $1 = path, $2 = root
  path=$1
  root=$2
  [ -n "$root" ] || return 1
  case "$path" in
    "$root") return 1 ;;
    "$root"/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Compute the Workspace + root for a pane, per the ordered candidate rule.
# Prints "workspace<TAB>root" (root may be empty) on success.
compute_workspace() {
  # $1 = activity, $2 = cwd, $3 = pane_title, $4 = session, $5 = session_path
  activity=$1
  cwd=$2
  pane_title=$3
  session=$4
  session_path=$5

  case "$activity" in
    ssh | mosh)
      host=$(remote_host_from_title "$pane_title")
      if [ -n "$host" ]; then
        printf '%s\t%s' "$host" ""
        return 0
      fi
      ;;
  esac

  if [ -n "$session" ] && [ -n "$session_path" ] &&
    [ "$(basename -- "$session_path")" = "$session" ]; then
    if [ "$cwd" = "$session_path" ] || is_under "$cwd" "$session_path"; then
      printf '%s\t%s' "$session" "$session_path"
      return 0
    fi
  fi

  if [ -n "$cwd" ] && command -v git >/dev/null 2>&1; then
    toplevel=$(cd "$cwd" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || toplevel=""
    if [ -n "$toplevel" ]; then
      printf '%s\t%s' "$(basename -- "$toplevel")" "$toplevel"
      return 0
    fi
  fi

  if [ -n "$session" ]; then
    printf '%s\t%s' "$session" ""
    return 0
  fi

  if [ -n "$cwd" ]; then
    printf '%s\t%s' "$(basename -- "$cwd")" "$cwd"
    return 0
  fi

  printf '%s\t%s' "shell" ""
}

# Area: cwd relative to root, only when cwd is a strict descendant of root.
# Truncated to the first $3 path segments ($3 = @tmux-autoname-area-depth,
# default 1); 0 means unlimited (the full relative path).
compute_area() {
  # $1 = cwd, $2 = root, $3 = depth
  cwd=$1
  root=$2
  depth=$3
  is_under "$cwd" "$root" || { printf ''; return 0; }
  rel=${cwd#"$root"/}

  case "$depth" in
    '' | *[!0-9]* | 0) : ;;
    *)
      kept=""
      remaining=$rel
      n=0
      while [ "$n" -lt "$depth" ]; do
        n=$((n + 1))
        case "$remaining" in
          */*)
            seg=${remaining%%/*}
            remaining=${remaining#*/}
            ;;
          *)
            seg=$remaining
            remaining=""
            ;;
        esac
        if [ -n "$kept" ]; then
          kept="$kept/$seg"
        else
          kept=$seg
        fi
        [ -n "$remaining" ] || break
      done
      rel=$kept
      ;;
  esac

  printf '%s' "$rel"
}

# Apply renderName's cleanup: collapse repeated ":"/"/" , drop ":/" runs,
# trim leading/trailing ":" or "/", collapse internal whitespace.
render_name() {
  printf '%s' "$1" |
    LC_ALL=C sed -E \
      -e 's/:+/:/g' \
      -e 's#/{2,}#/#g' \
      -e 's#:/#:#g' \
      -e 's/^[:\/]+//' \
      -e 's/[:\/]+$//' \
      -e 's/[[:space:]]+/ /g'
}

do_sync() {
  target=$1
  if [ -z "$target" ]; then
    target=$(tmux display-message -p '#{window_id}' 2>/dev/null) || return 0
  fi
  win=$(tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null) || return 0
  [ -n "$win" ] || return 0
  active_pane=$(tmux display-message -p -t "$win" '#{pane_id}' 2>/dev/null) || return 0
  [ -n "$active_pane" ] || return 0

  applied=$(wopt "$win" @tmux-autoname-applied)
  curname=$(tmux display-message -p -t "$win" '#{window_name}' 2>/dev/null) || curname=""
  if [ -n "$applied" ] && [ "$curname" != "$applied" ]; then
    return 0
  fi

  # A just-created pane briefly reports pane_current_command as "tmux"
  # itself (or empty), before the shell it execs has taken over - a race
  # between this hook firing and that fork/exec completing. Since no hook
  # fires again once the shell settles, naming the window from that
  # placeholder here would stick forever. Retry a few times first; this
  # normally resolves within a couple of iterations.
  tries=0
  pcmd=$(pane_field "$active_pane" pane_current_command)
  while [ "$tries" -lt 10 ] && { [ -z "$pcmd" ] || [ "$pcmd" = "tmux" ]; }; do
    sleep 0.05
    pcmd=$(pane_field "$active_pane" pane_current_command)
    tries=$((tries + 1))
  done
  if is_wrapper_command "$pcmd"; then
    pane_pid=$(pane_field "$active_pane" pane_pid)
    resolved=$(foreground_argv "$pane_pid" | resolve_argv) || resolved=""
    [ -z "$resolved" ] || pcmd=$resolved
  fi
  pane_title=$(pane_field "$active_pane" pane_title)
  cwd=$(pane_field "$active_pane" pane_current_path)
  session=$(tmux display-message -p -t "$win" '#{session_name}' 2>/dev/null) || session=""
  session_path=$(tmux display-message -p -t "$win" '#{session_path}' 2>/dev/null) || session_path=""

  activity=$(compute_activity "$pcmd")
  ws_and_root=$(compute_workspace "$activity" "$cwd" "$pane_title" "$session" "$session_path")
  workspace=${ws_and_root%%	*}
  root=${ws_and_root#*	}

  area_depth=$(gopt @tmux-autoname-area-depth 1)
  area=""
  if [ -n "$root" ] && [ -n "$cwd" ]; then
    area=$(compute_area "$cwd" "$root" "$area_depth")
  fi

  if [ -n "$area" ]; then
    raw_name="$activity:$workspace/$area"
  else
    raw_name="$activity:$workspace"
  fi
  newname=$(render_name "$raw_name")

  if [ "$curname" != "$newname" ]; then
    tmux rename-window -t "$win" -- "$newname" 2>/dev/null || true
  fi
  wset "$win" @tmux-autoname-applied "$newname"
  return 0
}

cmd_sync() {
  opt_t=""
  if [ "${1:-}" = "-t" ]; then
    opt_t=${2:-}
    shift 2
  fi
  do_sync "$opt_t"
}

cmd_auto() {
  opt_t=""
  if [ "${1:-}" = "-t" ]; then
    opt_t=${2:-}
    shift 2
  fi
  win=$(resolve_win "$opt_t")
  [ -n "$win" ] || return 1
  wunset "$win" @tmux-autoname-applied
  do_sync "$win"
}

cmd_status() {
  opt_t=""
  if [ "${1:-}" = "-t" ]; then
    opt_t=${2:-}
    shift 2
  fi
  win=$(resolve_win "$opt_t")
  [ -n "$win" ] || return 1
  applied=$(wopt "$win" @tmux-autoname-applied)
  curname=$(tmux display-message -p -t "$win" '#{window_name}' 2>/dev/null) || curname=""

  manual=no
  if [ -n "$applied" ] && [ "$curname" != "$applied" ]; then
    manual=yes
  fi

  printf 'name: %s\n' "$curname"
  printf 'applied: %s\n' "$applied"
  printf 'manual: %s\n' "$manual"
}

cmd_help() {
  cat <<'EOF'
tmux-autoname: deterministic <activity>:<workspace>[/<area>] window names.

Usage:
  tmux-autoname sync [-t pane_or_window]
  tmux-autoname auto [-t window]
  tmux-autoname status [-t window]
  tmux-autoname help

sync renames the window a pane belongs to, from that window's currently
active pane. auto forgets a manual rename and re-syncs. status prints
the window's current name and manual-rename state.
EOF
}

main() {
  sub=${1:-help}
  [ $# -gt 0 ] && shift
  case "$sub" in
    sync) cmd_sync "$@" ;;
    auto) cmd_auto "$@" ;;
    status) cmd_status "$@" ;;
    help | -h | --help) cmd_help ;;
    *)
      cmd_help >&2
      exit 1
      ;;
  esac
}

main "$@"
