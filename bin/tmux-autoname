#!/usr/bin/env sh
# tmux-autoname: deterministic window names (A:W/R, A:W, A:R or A from
# Activity, Workspace, Area) and a per-window @tmux-autoname-icon.
# See docs/adr/0006-rewrite-with-icons.md.
set -euf

# -u: without a UTF-8 locale tmux prints non-ASCII bytes as "_".
tmux() { command tmux -u "$@"; }

DEFAULT_ICON='󰆍'

# Every field sync needs, read in one display-message call, one per line.
# A control-character separator is not portable: tmux 3.4 prints it as the
# text "\037". The trailing "." keeps final empty lines.
NL='
'
FIELDS="#{window_id}${NL}#{pane_id}${NL}#{pane_active}${NL}#{window_name}${NL}\
#{pane_current_command}${NL}#{pane_pid}${NL}#{pane_title}${NL}\
#{pane_current_path}${NL}#{session_name}${NL}#{session_path}${NL}\
#{@tmux-autoname-applied}${NL}#{@tmux-autoname-icon}${NL}\
#{@tmux-autoname-area-depth}${NL}#{@tmux-autoname-omit-session}${NL}\
#{@tmux-autoname-icons}${NL}#{@tmux-autoname-icon-default}${NL}."

# Sets win pane pane_active name pcmd pane_pid title cwd session session_path
# applied icon_cur depth omit icons icon_default from the lines of $1. Fails
# unless there are exactly 17 lines (a value with a newline in it).
assign_fields() {
  n=0
  while IFS= read -r line; do
    n=$((n + 1))
    case $n in
      1) win=$line ;; 2) pane=$line ;; 3) pane_active=$line ;;
      4) name=$line ;; 5) pcmd=$line ;; 6) pane_pid=$line ;;
      7) title=$line ;; 8) cwd=$line ;; 9) session=$line ;;
      10) session_path=$line ;; 11) applied=$line ;; 12) icon_cur=$line ;;
      13) depth=$line ;; 14) omit=$line ;; 15) icons=$line ;;
      16) icon_default=$line ;;
    esac
  done <<EOF_FIELDS
$1
EOF_FIELDS
  [ "$n" -eq 17 ]
}

# Read the fields of the window's ACTIVE pane. $1 = target (may be empty).
read_window() {
  if [ -n "$1" ]; then
    out=$(tmux display-message -p -t "$1" "$FIELDS" 2>/dev/null) || return 1
  else
    out=$(tmux display-message -p "$FIELDS" 2>/dev/null) || return 1
  fi
  assign_fields "$out" || return 1
  [ -n "$win" ] || return 1
  # A pane target may not be the active pane; name from the active one.
  if [ "$pane_active" != 1 ]; then
    out=$(tmux display-message -p -t "$win" "$FIELDS" 2>/dev/null) || return 1
    assign_fields "$out" || return 1
  fi
  return 0
}

# Activity of a command name: basename, lower-cased, "-coding-agent"
# removed, only [a-z0-9._+-] kept, empty -> "shell", mosh-client -> mosh.
compute_activity() {
  # $1 = command
  a=$(printf '%s' "${1##*/}" | LC_ALL=C sed \
    -e 'y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/' \
    -e 's/-coding-agent$//' -e 's/[^a-z0-9._+-]//g')
  case "$a" in
    '') a=shell ;;
    mosh-client) a=mosh ;;
  esac
  printf '%s' "$a"
}

# True (0) when an Activity is a launcher (sudo, env, ...) or an
# interpreter (node, python, ...) whose real program is further down argv.
is_wrapper() {
  # $1 = activity
  case "$1" in
    sudo | doas | env | nice | ionice | nohup | time | stdbuf | setsid | \
      timeout | taskset | chrt | flock | systemd-run | unbuffer | chronic | \
      node | nodejs | node[0-9]* | bun | deno | \
      python | python[0-9]* | pypy | pypy[0-9]* | ruby | ruby[0-9]* | perl | perl[0-9]*)
      return 0
      ;;
  esac
  return 1
}

# Print the argv of the foreground process group leader of a pane's tty,
# one argument per line. Empty when it can't be read.
foreground_argv() {
  # $1 = pane_pid
  case "$1" in '' | *[!0-9]*) return 0 ;; esac
  if [ -r "/proc/$1/stat" ]; then
    stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
    # Fields after "(comm) ": state ppid pgrp session tty_nr tpgid ...
    # shellcheck disable=SC2086
    set -- ${stat##*) }
    fg=${6:-}
    case "$fg" in '' | *[!0-9]* | 0 | -*) return 0 ;; esac
    tr '\0' '\n' <"/proc/$fg/cmdline" 2>/dev/null || true
  else
    fg=$(ps -o tpgid= -p "$1" 2>/dev/null | tr -d ' ') || return 0
    case "$fg" in '' | *[!0-9]* | 0) return 0 ;; esac
    # ps joins argv with spaces, so an argument that contains a space is
    # split in two here (a known limit without /proc).
    ps -ww -o args= -p "$fg" 2>/dev/null | tr ' ' '\n' || true
  fi
}

# Resolve a launcher/interpreter argv (one arg per line on stdin) to the
# program it really runs: `doas emerge -a` -> emerge,
# `node .../bin/codex` -> codex, `python3 -m http.server` -> http.server.
# Prints nothing when argv is empty.
resolve_argv() {
  LC_ALL=C awk '
    function base(p) { sub(/\/+$/, "", p); sub(/.*\//, "", p); return p }
    function lc(s) { return tolower(s) }
    function is_launcher(n) {
      return n ~ /^(sudo|doas|env|nice|ionice|nohup|time|stdbuf|setsid|timeout|taskset|chrt|flock|systemd-run|unbuffer|chronic)$/
    }
    function is_interp(n) {
      return n ~ /^(node|nodejs|node[0-9].*|bun|deno|python|python[0-9].*|pypy|pypy[0-9].*|ruby|ruby[0-9].*|perl|perl[0-9].*)$/
    }
    # Options that consume the following argument, per launcher.
    function takes_value(n, o) {
      if (n == "sudo") return o ~ /^-[uUgCDhprtTR]$/
      if (n == "doas") return o ~ /^-[uC]$/
      if (n == "env") return o ~ /^(-u|--unset|-C|--chdir|-S|--split-string)$/
      if (n == "nice") return o ~ /^(-n|--adjustment)$/
      if (n == "ionice") return o ~ /^(-c|--class|-n|--classdata|-p|--pid|-P|--pgid|-u|--uid)$/
      if (n == "stdbuf") return o ~ /^-[ioe]$/
      if (n == "timeout") return o ~ /^(-s|--signal|-k|--kill-after)$/
      if (n == "time") return o ~ /^(-f|--format|-o|--output)$/
      if (n == "flock") return o ~ /^(-w|--timeout|-E|--conflict-exit-code)$/
      if (n == "systemd-run") return o ~ /^(-u|--unit|-p|--property|-E|--setenv|--description|--slice|-M|--machine|-H|--host|--uid|--gid|--nice|-D|--working-directory|--on-active|--on-boot|--on-startup|--on-unit-active|--on-unit-inactive|--on-calendar|--timer-property|--path-property|--socket-property|--service-type)$/
      if (n == "chrt") return o ~ /^(-T|--sched-runtime|-P|--sched-period|-D|--sched-deadline)$/
      return 0
    }
    # Positional arguments a launcher takes before the command.
    function leading_positionals(n) {
      if (n == "timeout" || n == "taskset" || n == "chrt" || n == "flock") return 1
      return 0
    }
    function script_name(p,    parts, k, s) {
      k = split(p, parts, "/")
      s = parts[k]
      sub(/\.([cm]?[jt]sx?|py[cw]?|rb|pl)$/, "", s)
      # Generic entry points name the package directory, not the program.
      while (k > 1 && lc(s) ~ /^(cli|index|main|__main__|run|entry|start|bin|dist|lib|src|build|out|esm|cjs)$/) {
        k--
        s = parts[k]
      }
      return s
    }
    { argv[n++] = $0 }
    END {
      i = 0
      while (i < n) {
        name = base(argv[i])
        ln = lc(name)
        if (is_launcher(ln)) {
          j = i + 1
          need = leading_positionals(ln)
          while (j < n) {
            a = argv[j]
            if (a == "--") { j++; break }
            if (ln == "env" && a ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { j++; continue }
            if (a ~ /^-./) { j += takes_value(ln, a) ? 2 : 1; continue }
            if (need > 0) { need--; j++; continue }
            break
          }
          if (j >= n) { print name; exit }
          i = j
          continue
        }
        if (is_interp(ln)) {
          j = i + 1
          sub_seen = 0
          while (j < n) {
            a = argv[j]
            if (a == "--") { j++; break }
            if (a ~ /^-/) {
              if (ln ~ /^(node|nodejs|node[0-9].*|bun|deno)$/) {
                if (a ~ /^(-e|--eval|-p|--print)$/) { print name; exit }
                if (a ~ /^(-r|--require|--import|--loader|--experimental-loader|-C|--conditions)$/) { j += 2; continue }
              } else if (ln ~ /^(python|pypy)/) {
                if (a == "-c") { print name; exit }
                if (a == "-m") {
                  if (j + 1 < n) { m = argv[j + 1]; sub(/\.__main__$/, "", m); print m } else print name
                  exit
                }
                if (a ~ /^-[WX]$/) { j += 2; continue }
              } else if (ln ~ /^ruby/) {
                if (a == "-e") { print name; exit }
                if (a ~ /^-[rIC]$/) { j += 2; continue }
              } else if (ln ~ /^perl/) {
                if (a ~ /^-[eE]$/) { print name; exit }
                if (a ~ /^-[IM]$/) { j += 2; continue }
              }
              j++
              continue
            }
            # bun run x / deno run x: skip the subcommand word once.
            if (!sub_seen && ln ~ /^(bun|deno)$/ && a ~ /^(run|x|task)$/) { sub_seen = 1; j++; continue }
            break
          }
          if (j >= n) { print name; exit }
          s = script_name(argv[j])
          if (s == "") s = name
          print s
          exit
        }
        print name
        exit
      }
    }
  '
}

# Remote host from an ssh/mosh argv (one arg per line on stdin): the first
# positional after the ssh/mosh word, without ssh://, user@ or :port,
# lower-cased. Prints nothing unless that looks like a host name.
host_from_argv() {
  LC_ALL=C awk '
    function base(p) { sub(/\/+$/, "", p); sub(/.*\//, "", p); return tolower(p) }
    { argv[n++] = $0 }
    END {
      for (i = 0; i < n && base(argv[i]) !~ /^(ssh|mosh)$/; i++) ;
      prog = base(argv[i])
      for (i++; i < n; i++) {
        a = argv[i]
        if (a == "--") { i++; break }
        if (a !~ /^-./) break
        # Getopt cluster: the first value-taking letter takes the rest of
        # the cluster as its value, or the next argument when it is last.
        if (a ~ /^-[A-Za-z0-9]+$/) {
          for (k = 2; k <= length(a); k++)
            if (index("BbcDEeFIiJLlmOoPpQRSWw", substr(a, k, 1))) {
              if (k == length(a)) i++
              break
            }
          continue
        }
        if (prog == "mosh" && a ~ /^--(ssh|port|predict|family|server|bind-server|experimental-remote-ip)$/) { i++; continue }
      }
      if (i >= n) exit
      h = tolower(argv[i])
      sub(/^ssh:\/\//, "", h)
      sub(/.*@/, "", h)
      sub(/[:\/].*$/, "", h)
      if (h ~ /^[a-z0-9][a-z0-9._-]*$/) print h
    }
  '
}

# Parse a remote host out of an ssh/mosh pane_title, lower-cased.
host_from_title() {
  # $1 = pane_title
  printf '%s' "$1" | LC_ALL=C sed -nE \
    's/^[[:space:]]*(([^@[:space:]]+@)?([a-zA-Z0-9][a-zA-Z0-9.-]{0,252})([:[:space:]].*|$)).*/\3/p' |
    sed -n '1p' |
    LC_ALL=C tr '[:upper:]' '[:lower:]'
}

# Icon for an Activity: @tmux-autoname-icons pairs, then the built-in
# table, then the default.
icon_for() {
  # $1 = activity, $2 = @tmux-autoname-icons, $3 = @tmux-autoname-icon-default
  for pair in $2; do
    case "$pair" in ?*=*) ;; *) continue ;; esac
    # shellcheck disable=SC2254
    case "$1" in ${pair%%=*})
      printf '%s' "${pair#*=}"
      return 0
      ;;
    esac
  done
  case "$1" in
    nvim* | vim* | vi) printf '%s' '' ;;
    claude*) printf '%s' '✻' ;;
    codex* | opencode* | pi) printf '%s' '󰚩' ;;
    ssh* | mosh*) printf '%s' '󰣀' ;;
    btop* | htop* | top) printf '%s' '󰍛' ;;
    python* | ipython*) printf '%s' '' ;;
    git* | lazygit* | tig) printf '%s' '󰊢' ;;
    yazi* | lf | ranger*) printf '%s' '󰉋' ;;
    man | less | bat) printf '%s' '󰈙' ;;
    zsh* | bash* | fish* | dash* | sh | shell) printf '%s' '' ;;
    *) printf '%s' "${3:-$DEFAULT_ICON}" ;;
  esac
}

# Activity of the fields read by read_window: waits out the fresh-pane race
# and resolves launchers and interpreters. Sets activity and argv.
resolve_activity() {
  # A just-created pane briefly reports pane_current_command as "tmux"
  # (or empty) before the shell it execs takes over. No hook fires once
  # the shell settles, so retry a few times before naming from it.
  tries=0
  while [ "$tries" -lt 10 ] && { [ -z "$pcmd" ] || [ "$pcmd" = tmux ]; }; do
    sleep 0.05
    pcmd=$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null) || pcmd=""
    tries=$((tries + 1))
  done
  activity=$(compute_activity "$pcmd")
  argv=""
  if is_wrapper "$activity"; then
    argv=$(foreground_argv "$pane_pid")
    resolved=$(printf '%s\n' "$argv" | resolve_argv) || resolved=""
    [ -z "$resolved" ] || activity=$(compute_activity "$resolved")
  elif [ "$activity" = ssh ] || [ "$activity" = mosh ]; then
    # mosh-client's argv is an IP and port, not the user's host.
    [ "${pcmd##*/}" = mosh-client ] || argv=$(foreground_argv "$pane_pid")
  fi
  return 0
}

# True (0) when $1 is a strict descendant of $2.
is_under() {
  [ -n "$2" ] || return 1
  case "$1" in "$2"/?*) return 0 ;; esac
  return 1
}

# Sets workspace and root (root may be empty).
compute_workspace() {
  root=""
  case "$activity" in
    ssh | mosh)
      workspace=""
      [ -z "$argv" ] || workspace=$(printf '%s\n' "$argv" | host_from_argv)
      [ -n "$workspace" ] || workspace=$(host_from_title "$title")
      [ -z "$workspace" ] || return 0
      ;;
  esac
  if [ -n "$session" ] && [ "${session_path##*/}" = "$session" ] &&
    { [ "$cwd" = "$session_path" ] || is_under "$cwd" "$session_path"; }; then
    workspace=$session root=$session_path
    return 0
  fi
  if [ -n "$cwd" ] && [ -d "$cwd" ]; then
    top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || top=""
    if [ -n "$top" ]; then
      workspace=${top##*/} root=$top
      return 0
    fi
  fi
  workspace=$session
}

# Area: cwd relative to root, when strictly under it, capped to the first
# $3 segments (0 = unlimited).
compute_area() {
  # $1 = cwd, $2 = root, $3 = depth
  is_under "$1" "$2" || return 0
  rel=${1#"$2"/}
  kept=""
  n=0
  while [ "$3" -eq 0 ] || [ "$n" -lt "$3" ]; do
    n=$((n + 1))
    seg=${rel%%/*}
    kept=${kept:+$kept/}$seg
    case "$rel" in */*) rel=${rel#*/} ;; *) break ;; esac
  done
  printf '%s' "$kept"
}

# Sets v to $1 made safe as a word of a batched tmux call: tmux takes a
# word that ends in ";" as a command separator unless it ends in "\;".
batch_word() {
  case "$1" in
    *';') v="${1%;}\\;" ;;
    *) v=$1 ;;
  esac
}

is_manual() {
  [ -n "$applied" ] && [ "$name" != "$applied" ]
}

do_sync() {
  # $1 = target (pane, window, or empty for current)
  read_window "$1" || return 0
  resolve_activity
  icon=$(icon_for "$activity" "$icons" "$icon_default")

  # One tmux call for every write, each only when its value changes.
  set --
  if [ "$icon" != "$icon_cur" ]; then
    batch_word "$icon"
    set -- "$@" set-option -wq -t "$win" @tmux-autoname-icon "$v" ';'
  fi

  if ! is_manual; then
    compute_workspace
    case "$depth" in '' | *[!0-9]*) depth=1 ;; esac
    area=$(compute_area "$cwd" "$root" "$depth")
    case "$omit" in off | no | false | 0) ;; *) [ "$workspace" != "$session" ] || workspace="" ;; esac

    if [ -n "$workspace" ] && [ -n "$area" ]; then
      newname="$activity:$workspace/$area"
    elif [ -n "$workspace" ]; then
      newname="$activity:$workspace"
    elif [ -n "$area" ]; then
      newname="$activity:$area"
    else
      newname=$activity
    fi

    # tmux rejects a name with a control character.
    case "$newname" in
      *[[:cntrl:]]*) newname=$(printf '%s' "$newname" | tr -d '[:cntrl:]') ;;
    esac

    # rename-window format-expands its argument and tmux escapes some bytes
    # when it stores a name, so record the stored #{window_name}, not
    # $newname. If tmux rejects the rename, the rest of the batch does not
    # run and the window does not turn into a Manual Name.
    renamed=no
    if [ "$newname" != "$name" ]; then
      renamed=yes
      case "$newname" in
        *'#'*) newname=$(printf '%s' "$newname" | sed 's/#/##/g') ;;
      esac
      batch_word "$newname"
      set -- "$@" rename-window -t "$win" -- "$v" ';'
    fi
    if [ "$renamed" = yes ] || [ -z "$applied" ]; then
      set -- "$@" set-option -wqF -t "$win" @tmux-autoname-applied \
        '#{window_name}' ';'
    fi
    # The first time, turn tmux's automatic-rename off explicitly: when the
    # name already matches, no rename-window does it, and tmux's own rename
    # would later look like a Manual Name.
    [ -n "$applied" ] ||
      set -- "$@" set-option -wq -t "$win" automatic-rename off ';'
  fi

  [ $# -eq 0 ] || tmux "$@" >/dev/null 2>&1 || true
  return 0
}

parse_target() {
  # Sets target from "[-t target]".
  target=""
  if [ "${1:-}" = -t ]; then
    target=${2:-}
  fi
}

cmd_sync() {
  parse_target "$@"
  do_sync "$target"
}

cmd_auto() {
  parse_target "$@"
  read_window "$target" || return 1
  tmux set-option -wqu -t "$win" @tmux-autoname-applied 2>/dev/null || true
  do_sync "$win"
}

cmd_status() {
  parse_target "$@"
  read_window "$target" || return 1
  resolve_activity
  manual=no
  is_manual && manual=yes
  printf 'name: %s\n' "$name"
  printf 'applied: %s\n' "$applied"
  printf 'manual: %s\n' "$manual"
  printf 'activity: %s\n' "$activity"
  printf 'icon: %s\n' "$(icon_for "$activity" "$icons" "$icon_default")"
}

cmd_help() {
  cat <<'EOF'
tmux-autoname: deterministic window names: A:W/R, A:W, A:R or A, from the
Activity A, Workspace W and Area R.

Usage:
  tmux-autoname sync [-t pane_or_window]
  tmux-autoname auto [-t window]
  tmux-autoname status [-t window]
  tmux-autoname help

sync names a window from its active pane and sets its @tmux-autoname-icon;
a window with a Manual Name keeps its name and only gets the icon. auto
forgets the Manual Name and syncs. status prints the window's name,
applied name, manual state, Activity and icon.
EOF
}

main() {
  sub=${1:-help}
  [ $# -eq 0 ] || shift
  case "$sub" in
    sync) cmd_sync "$@" ;;
    auto) cmd_auto "$@" ;;
    status) cmd_status "$@" ;;
    help | -h | --help) cmd_help ;;
    *)
      cmd_help >&2
      exit 1
      ;;
  esac
}

main "$@"
